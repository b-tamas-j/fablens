# Copy to .env and fill in the keys. Models use the LangChain "provider:model" format.
LLM_MODEL=groq:openai/gpt-oss-120b
LLM_FALLBACK_MODEL=google_genai:gemini-3.5-flash-lite

GROQ_API_KEY=
GOOGLE_API_KEY=

# Optional: base URL of the server in the A2A agent card (default http://localhost:8000).
# PUBLIC_URL=http://localhost:8000
